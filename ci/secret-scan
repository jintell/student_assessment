#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
version="8.30.1"
os="$(uname -s | tr '[:upper:]' '[:lower:]')"
machine="$(uname -m)"

case "${machine}" in
    arm64 | aarch64) arch="arm64" ;;
    x86_64 | amd64) arch="x64" ;;
    *) echo "Unsupported Gitleaks architecture: ${machine}" >&2; exit 2 ;;
esac

case "${os}_${arch}" in
    darwin_arm64) checksum="b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5" ;;
    darwin_x64) checksum="dfe101a4db2255fc85120ac7f3d25e4342c3c20cf749f2c20a18081af1952709" ;;
    linux_arm64) checksum="e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080" ;;
    linux_x64) checksum="551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb" ;;
    *) echo "Unsupported Gitleaks platform: ${os}_${arch}" >&2; exit 2 ;;
esac

archive="gitleaks_${version}_${os}_${arch}.tar.gz"
tool_dir="${GITLEAKS_CACHE_DIR:-${repo_root}/build/tools/gitleaks/${version}/${os}_${arch}}"
gitleaks="${tool_dir}/gitleaks"

verify_checksum() {
    local file="$1"
    local actual
    if command -v sha256sum >/dev/null 2>&1; then
        actual="$(sha256sum "${file}" | awk '{print $1}')"
    else
        actual="$(shasum -a 256 "${file}" | awk '{print $1}')"
    fi
    if [[ "${actual}" != "${checksum}" ]]; then
        echo "Gitleaks archive checksum mismatch: expected ${checksum}, got ${actual}" >&2
        exit 1
    fi
}

if [[ ! -x "${gitleaks}" ]]; then
    mkdir -p "${tool_dir}"
    temporary_archive="${tool_dir}/${archive}.tmp"
    curl --fail --location --silent --show-error \
        "https://github.com/gitleaks/gitleaks/releases/download/v${version}/${archive}" \
        --output "${temporary_archive}"
    verify_checksum "${temporary_archive}"
    tar -xzf "${temporary_archive}" -C "${tool_dir}" gitleaks
    rm -f "${temporary_archive}"
fi

report_dir="${repo_root}/build/reports/secret-scan"
mkdir -p "${report_dir}"
config="${repo_root}/config/gitleaks.toml"

"${gitleaks}" git "${repo_root}" \
    --config "${config}" \
    --log-opts="--all" \
    --no-banner \
    --redact \
    --report-format json \
    --report-path "${report_dir}/history.json"

"${gitleaks}" dir "${repo_root}" \
    --config "${config}" \
    --no-banner \
    --redact \
    --report-format json \
    --report-path "${report_dir}/working-tree.json"

cat > "${report_dir}/summary.json" <<EOF
{
  "scanner": "gitleaks",
  "version": "${version}",
  "history": "PASS",
  "workingTree": "PASS"
}
EOF

echo "Secret scan passed for Git history and working tree."
