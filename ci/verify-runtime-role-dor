#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
record="${repo_root}/ci/dor/FEAT-PLAT-006/P0.4-runtime-role-dor.json"
signature="${repo_root}/ci/dor/FEAT-PLAT-006/P0.4-runtime-role-dor.platform-ops.sig"
ratification="${repo_root}/ci/architecture-ratification.json"
trusted_keys="${repo_root}/ci/trusted-ratification-keys.json"

fail() {
    echo "RUNTIME ROLE DOR: FAIL" >&2
    echo "$1" >&2
    exit 1
}

for command in awk gpg jq; do
    command -v "${command}" >/dev/null 2>&1 || fail "Required command is unavailable: ${command}"
done

[[ -f "${record}" ]] || fail "Definition of Ready record is missing."
[[ -f "${signature}" ]] || fail "Platform Ops signature is missing."
[[ -f "${ratification}" ]] || fail "Architecture ratification is missing."
[[ -f "${trusted_keys}" ]] || fail "Trusted approver registry is missing."

jq -e '
    .recordId == "DOR-FEAT-PLAT-006-P0.4"
    and .feature == "FEAT-PLAT-006"
    and .dependency == "P0.4"
    and .status == "APPROVED"
    and .architecture.version == "1.4"
    and .architecture.gitTag == "arch-v1.4"
    and (.architecture.sections | sort == ["17.1", "8.2"])
    and .baselineVersionResolution.defectId == "TASK-PLAT6-OBS-005"
    and .baselineVersionResolution.universalDorVersion == "1.3"
    and .baselineVersionResolution.phase0EntryVersion == "1.4"
    and .baselineVersionResolution.versionRead == "1.4"
    and (.approvals | length == 1)
    and .approvals[0].role == "Platform Ops"
    and .approvals[0].identity == "Josiah Adetayo"
    and .approvals[0].decision == "APPROVED"
    and .approvals[0].signature == "P0.4-runtime-role-dor.platform-ops.sig"
    and (.approvals[0].approvedAt | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T"))
' "${record}" >/dev/null || fail "Definition of Ready record is malformed or incomplete."

jq -e --slurpfile ratification "${ratification}" '
    .architecture.version == $ratification[0].baseline.architectureVersion
    and .architecture.gitTag == $ratification[0].baseline.gitTag
    and .architecture.gitCommit == $ratification[0].baseline.gitCommit
    and .architecture.documentPath == $ratification[0].baseline.documentPath
    and .architecture.blobSha256 == $ratification[0].baseline.blobSha256
    and $ratification[0].status == "RATIFIED"
' "${record}" >/dev/null || fail "Definition of Ready baseline differs from ratification."

expected_fingerprint="$(jq -r '."Architecture Owner".fingerprint' "${trusted_keys}")"
declared_fingerprint="$(jq -r '.approvals[0].fingerprint' "${record}")"
[[ "${declared_fingerprint}" == "${expected_fingerprint}" ]] \
    || fail "Platform Ops signer is not the designated trusted identity."

gnupg_home="$(mktemp -d)"
cleanup() {
    rm -rf -- "${gnupg_home}"
}
trap cleanup EXIT
chmod 0700 "${gnupg_home}"

gpg --homedir "${gnupg_home}" --batch --quiet \
    --import "${repo_root}/ci/trusted-architecture-owner.asc" >/dev/null 2>&1 \
    || fail "Unable to import the trusted Platform Ops key."

status="$(
    gpg --homedir "${gnupg_home}" --batch --status-fd 1 \
        --verify "${signature}" "${record}" 2>/dev/null
)" || fail "Platform Ops signature is invalid or untrusted."
verified_fingerprint="$(awk '$2 == "VALIDSIG" {print $3; exit}' <<<"${status}")"
[[ "${verified_fingerprint}" == "${declared_fingerprint}" ]] \
    || fail "Platform Ops signature fingerprint does not match the record."

echo "RUNTIME ROLE DOR: PASS"
echo "Platform Ops approval, architecture v1.4, and sections 8.2 and 17.1 are verified."
