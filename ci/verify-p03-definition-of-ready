#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
approval="${repo_root}/ci/dor/P0.3-dor-approval.json"
ratification="${repo_root}/ci/architecture-ratification.json"
trusted_keys="${repo_root}/ci/trusted-ratification-keys.json"
architecture_repository="${ARCHITECTURE_REPOSITORY:-${repo_root}/../student_assessment}"

fail() {
    echo "P0.3 DEFINITION OF READY: FAIL" >&2
    echo "$1" >&2
    exit 1
}

for command in jq git gpg; do
    command -v "${command}" >/dev/null 2>&1 || fail "Required command is unavailable: ${command}"
done

[[ -f "${approval}" ]] || fail "Approval record is missing: ${approval}"
[[ -f "${ratification}" ]] || fail "Architecture ratification record is missing."
[[ -f "${trusted_keys}" ]] || fail "Trusted ratification key registry is missing."

jq -e '
    type == "object"
    and .recordId == "DOR-P0.3-001"
    and .dependency == "P0.3"
    and .status == "APPROVED"
    and .scope.document == "workspace/v3/be/architecture.md"
    and .scope.section == "9.2"
    and .scope.architectureBaseline == "arch-v1.4"
    and (.scope.gitCommit | test("^[0-9a-f]{40}$"))
    and (.scope.documentSha256 | test("^[0-9a-f]{64}$"))
    and (.approvals | type == "array" and length == 2)
    and ([.approvals[].role] | sort == ["Architecture Owner", "Security"])
    and all(.approvals[];
        .decision == "APPROVED"
        and (.approvedAt | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T"))
        and (.signature | test("^[A-Za-z0-9._-]+\\.sig$")))
    and (.conditions | type == "array" and length > 0)
' "${approval}" >/dev/null || fail "Approval record is malformed or incomplete."

ratified_commit="$(jq -r '.baseline.gitCommit // empty' "${ratification}")"
ratified_sha256="$(jq -r '.baseline.blobSha256 // empty' "${ratification}")"
approval_commit="$(jq -r '.scope.gitCommit' "${approval}")"
approval_sha256="$(jq -r '.scope.documentSha256' "${approval}")"
[[ "${approval_commit}" == "${ratified_commit}" ]] \
    || fail "Approval commit does not match the ratified architecture commit."
[[ "${approval_sha256}" == "${ratified_sha256}" ]] \
    || fail "Approval hash does not match the ratified architecture hash."

resolved_commit="$(git -C "${architecture_repository}" rev-list -n 1 arch-v1.4 2>/dev/null || true)"
[[ "${resolved_commit}" == "${approval_commit}" ]] \
    || fail "Approval commit does not match the current arch-v1.4 tag."

if command -v sha256sum >/dev/null 2>&1; then
    actual_sha256="$(
        git -C "${architecture_repository}" cat-file blob \
            "${resolved_commit}:workspace/v3/be/architecture.md" | sha256sum | awk '{print $1}'
    )"
else
    actual_sha256="$(
        git -C "${architecture_repository}" cat-file blob \
            "${resolved_commit}:workspace/v3/be/architecture.md" | shasum -a 256 | awk '{print $1}'
    )"
fi
[[ "${actual_sha256}" == "${approval_sha256}" ]] \
    || fail "Approved architecture document hash does not match the tagged blob."

gnupg_home="$(mktemp -d)"
cleanup() {
    rm -rf -- "${gnupg_home}"
}
trap cleanup EXIT
chmod 0700 "${gnupg_home}"

while IFS= read -r public_key; do
    gpg --homedir "${gnupg_home}" --batch --quiet \
        --import "${repo_root}/ci/${public_key}" >/dev/null 2>&1 \
        || fail "Unable to import trusted approval key: ${public_key}"
done < <(jq -r 'to_entries[].value.publicKey' "${trusted_keys}")

verify_signature() {
    local role="$1"
    local signature_name signature_path status fingerprint
    signature_name="$(
        jq -r --arg role "${role}" '.approvals[] | select(.role == $role) | .signature' "${approval}"
    )"
    signature_path="${repo_root}/ci/dor/${signature_name}"
    [[ -f "${signature_path}" ]] || fail "${role} signature is missing."
    status="$(
        gpg --homedir "${gnupg_home}" --batch --status-fd 1 \
            --verify "${signature_path}" "${approval}" 2>/dev/null
    )" || fail "${role} signature is invalid or untrusted."
    fingerprint="$(awk '$2 == "VALIDSIG" {print $3; exit}' <<<"${status}")"
    [[ -n "${fingerprint}" ]] || fail "${role} signature fingerprint is unavailable."
    printf '%s\n' "${fingerprint}"
}

owner_fingerprint="$(verify_signature "Architecture Owner")"
expected_owner_fingerprint="$(jq -r '.["Architecture Owner"].fingerprint' "${trusted_keys}")"
[[ "${owner_fingerprint}" == "${expected_owner_fingerprint}" ]] \
    || fail "Architecture Owner signature does not use the designated trusted key."

security_fingerprint="$(verify_signature "Security")"
[[ "${security_fingerprint}" != "${owner_fingerprint}" ]] \
    || fail "Architecture Owner and Security approvals must have distinct signers."
jq -e --arg fingerprint "${security_fingerprint}" '
    any(to_entries[]; .value.fingerprint == $fingerprint)
' "${trusted_keys}" >/dev/null || fail "Security signature does not use a trusted key."

echo "P0.3 DEFINITION OF READY: PASS"
echo "Architecture section 9.2 ownership and grant matrix approvals are verified."
