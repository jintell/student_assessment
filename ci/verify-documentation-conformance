#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repo_root}"

pattern='(?<!REV[0-9]{1,3}-)ARCH-REVIEW-[0-9]{3}'
if rg --pcre2 --glob '*.md' --glob '!build/**' --glob '!.gradle/**' "${pattern}" .; then
    echo "ARC-VERIFY-016: unqualified architecture review citation found." >&2
    exit 1
fi

echo "ARC-VERIFY-016: documentation citations conform."
