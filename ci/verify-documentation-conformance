#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
architecture_repository="${ARCHITECTURE_REPOSITORY:-${repo_root}/../student_assessment}"
requirements="${architecture_repository}/workspace/v3/be/requirements.md"
architecture="${architecture_repository}/workspace/v3/be/architecture.md"
allowlist="${repo_root}/ci/documentation-conformance-allowlist.txt"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --requirements)
            requirements="$2"
            shift 2
            ;;
        --architecture)
            architecture="$2"
            shift 2
            ;;
        --allowlist)
            allowlist="$2"
            shift 2
            ;;
        *)
            echo "Unknown documentation-conformance argument: $1" >&2
            exit 2
            ;;
    esac
done

for required_file in "${requirements}" "${architecture}" "${allowlist}"; do
    if [[ ! -f "${required_file}" ]]; then
        echo "ARC-VERIFY-016: required input is unavailable: ${required_file}" >&2
        exit 1
    fi
done

actual="$(mktemp)"
expected="$(mktemp)"
cleanup() {
    rm -f -- "${actual}" "${expected}"
}
trap cleanup EXIT

# Detect candidate identifiers first, then explicitly check whether each one is
# immediately prefixed with REV<n>-. Avoid a PCRE2 variable-length lookbehind:
# (?<!REV[0-9]+-) is not portable because lookbehind must be fixed length.
python3 - "${requirements}" "${architecture}" <<'PYSCAN' | sort -u > "${actual}"
from __future__ import annotations

import re
import sys
from pathlib import Path

identifier_pattern = re.compile(
    r"(ARCH-REVIEW-[0-9]{3}|SPEC-CONFLICT-[0-9]{3})"
)
qualified_prefix_pattern = re.compile(r"REV[0-9]+-$")

for raw_path in sys.argv[1:]:
    path = Path(raw_path)

    try:
        content = path.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as exc:
        print(
            f"ARC-VERIFY-016: unable to read {path}: {exc}",
            file=sys.stderr,
        )
        raise SystemExit(2)

    for line_number, line in enumerate(content.splitlines(), start=1):
        for match in identifier_pattern.finditer(line):
            prefix = line[: match.start()]

            # Qualified citations such as REV1-ARCH-REVIEW-001 and
            # REV12-SPEC-CONFLICT-123 are conformant.
            if qualified_prefix_pattern.search(prefix):
                continue

            print(f"{path.name}:{line_number}:{match.group(1)}")
PYSCAN

sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "${allowlist}" | sort -u > "${expected}"

if ! diff -u "${expected}" "${actual}"; then
    echo "ARC-VERIFY-016: unqualified review citation differs from the reviewed allowlist." >&2
    echo "Namespace new citations as REV<n>-ARCH-REVIEW-### or REV<n>-SPEC-CONFLICT-###." >&2
    exit 1
fi

echo "ARC-VERIFY-016: requirements.md and architecture.md citations conform."
