#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
architecture_repository="${ARCHITECTURE_REPOSITORY:-${repo_root}/../student_assessment}"
requirements="${architecture_repository}/workspace/v3/be/requirements.md"
architecture="${architecture_repository}/workspace/v3/be/architecture.md"
allowlist="${repo_root}/ci/documentation-conformance-allowlist.txt"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --requirements)
            requirements="$2"
            shift 2
            ;;
        --architecture)
            architecture="$2"
            shift 2
            ;;
        --allowlist)
            allowlist="$2"
            shift 2
            ;;
        *)
            echo "Unknown documentation-conformance argument: $1" >&2
            exit 2
            ;;
    esac
done

for required_file in "${requirements}" "${architecture}" "${allowlist}"; do
    if [[ ! -f "${required_file}" ]]; then
        echo "ARC-VERIFY-016: required input is unavailable: ${required_file}" >&2
        exit 1
    fi
done

actual="$(mktemp)"
expected="$(mktemp)"
cleanup() {
    rm -f -- "${actual}" "${expected}"
}
trap cleanup EXIT

pattern='(?<!REV[0-9]{1,3}-)(ARCH-REVIEW-[0-9]{3}|SPEC-CONFLICT-[0-9]{3})'
while IFS=: read -r document line identifier; do
    printf '%s:%s:%s\n' "$(basename "${document}")" "${line}" "${identifier}"
done < <(rg --with-filename --no-heading --line-number --only-matching --pcre2 \
    "${pattern}" "${requirements}" "${architecture}" || true) | sort -u > "${actual}"

sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "${allowlist}" | sort -u > "${expected}"

if ! diff -u "${expected}" "${actual}"; then
    echo "ARC-VERIFY-016: unqualified review citation differs from the reviewed allowlist." >&2
    echo "Namespace new citations as REV<n>-ARCH-REVIEW-### or REV<n>-SPEC-CONFLICT-###." >&2
    exit 1
fi

echo "ARC-VERIFY-016: requirements.md and architecture.md citations conform."
