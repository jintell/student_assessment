apiVersion: v1
kind: Service
metadata:
  name: cbt-platform-postgres
  labels:
    app.kubernetes.io/name: cbt-platform-postgres
    cbt.meldtech.org/rehearsal: rollback
spec:
  selector:
    app.kubernetes.io/name: cbt-platform-postgres
  ports:
    - name: postgres
      port: 5432
      targetPort: postgres
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cbt-platform-postgres
  labels:
    app.kubernetes.io/name: cbt-platform-postgres
    cbt.meldtech.org/rehearsal: rollback
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: cbt-platform-postgres
  template:
    metadata:
      labels:
        app.kubernetes.io/name: cbt-platform-postgres
        cbt.meldtech.org/rehearsal: rollback
    spec:
      containers:
        - name: postgres
          image: ${CBT_POSTGRES_IMAGE_DIGEST}
          imagePullPolicy: IfNotPresent
          env:
            - name: POSTGRES_DB
              value: cbt_staging
            - name: POSTGRES_USER
              value: postgres
            - name: POSTGRES_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: cbt-platform-database
                  key: postgres-password
          ports:
            - name: postgres
              containerPort: 5432
          readinessProbe:
            exec:
              command: ["pg_isready", "-U", "postgres", "-d", "cbt_staging"]
            initialDelaySeconds: 2
            periodSeconds: 2
          resources:
            requests:
              cpu: 250m
              memory: 512Mi
            limits:
              cpu: "2"
              memory: 2Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cbt-platform
  labels:
    app.kubernetes.io/name: cbt-platform
    app.kubernetes.io/component: api
    cbt.meldtech.org/rehearsal: rollback
spec:
  replicas: 0
  selector:
    matchLabels:
      app.kubernetes.io/name: cbt-platform
      app.kubernetes.io/component: api
  template:
    metadata:
      labels:
        app.kubernetes.io/name: cbt-platform
        app.kubernetes.io/component: api
        cbt.meldtech.org/rehearsal: rollback
    spec:
      containers:
        - name: cbt-platform
          image: ${CBT_RELEASE_N_PLUS_ONE_IMAGE}
          imagePullPolicy: IfNotPresent
          env:
            - name: SPRING_PROFILES_ACTIVE
              value: api
            - name: SPRING_FLYWAY_ENABLED
              value: "false"
            - name: CBT_DATABASE_URL
              value: r2dbc:postgresql://cbt-platform-postgres:5432/cbt_staging
            - name: CBT_DATABASE_ROLES_APP_API_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: cbt-platform-database
                  key: app-api-password
          ports:
            - name: http
              containerPort: 8080
          readinessProbe:
            tcpSocket:
              port: http
            initialDelaySeconds: 5
            periodSeconds: 2
          resources:
            requests:
              cpu: 250m
              memory: 512Mi
            limits:
              cpu: "2"
              memory: 1Gi
          volumeMounts:
            - name: compatibility-probe
              mountPath: /rehearsal
              readOnly: true
      volumes:
        - name: compatibility-probe
          configMap:
            name: cbt-platform-compatibility-probe
