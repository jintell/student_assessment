apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: cbt-worker-management
  namespace: ${CBT_NAMESPACE}
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: cbt-platform
      app.kubernetes.io/component: worker
  policyTypes: [Ingress]
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: ${CBT_MONITORING_NAMESPACE}
          podSelector:
            matchLabels:
              app.kubernetes.io/name: prometheus
      ports:
        - protocol: TCP
          port: 9091
